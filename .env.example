# =============================================================================
# WhatsApp-n8n Bridge Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - only .env.example

# =============================================================================
# Application Environment (REQUIRED)
# =============================================================================
# Controls which git branch Docker pulls on startup
# Options: production, development
# - production: pulls from 'master' branch
# - development: pulls from 'dev' branch
APP_ENV=development
NODE_ENV=development
PORT=3000

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================
DB_HOST=mysql.thecoordinates.xyz
DB_PORT=3306
DB_USER=makeuser
DB_PASSWORD=your_password_here_change_me
DB_NAME=makebdd
DB_POOL_SIZE=10

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here_change_me
REDIS_DB=0

# =============================================================================
# WhatsApp Configuration (direct whatsapp-web.js integration)
# =============================================================================
# Session name for storing WhatsApp state
WA_SESSION_NAME=whatsapp-bridge
# Run in headless mode (set to false to see browser for debugging)
WA_HEADLESS=true
# Optional: WhatsApp business phone number (for logging)
WA_PHONE_NUMBER=

# =============================================================================
# n8n Integration
# =============================================================================
# Webhook URL where n8n receives incoming WhatsApp messages
# This should be your n8n instance publicly accessible URL
N8N_WEBHOOK_URL=https://n8n.thecoordinates.xyz/webhook/whatsapp
# n8n internal API endpoint (for workflow triggers)
N8N_API_URL=http://n8n:5678/api
# n8n API authentication token (if required)
N8N_API_KEY=your_n8n_api_key_here

# =============================================================================
# API Security
# =============================================================================
# API key for authenticating requests to WhatsApp Bridge service
API_KEY=your_api_key_here_generate_with_openssl
# Secret for signing webhooks (HMAC-SHA256)
WEBHOOK_SECRET=your_webhook_secret_here_generate_with_openssl
# JWT secret for internal token generation (optional)
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
# Options: json, text
LOG_FORMAT=json
# Log to file in addition to console
LOG_TO_FILE=true
LOG_DIR=./logs

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable webhook delivery
ENABLE_WEBHOOKS=true
# Enable message queuing
ENABLE_QUEUE=true
# Enable centralized logging to MySQL
ENABLE_EXECUTION_LOGGING=true

# =============================================================================
# Rate Limiting
# =============================================================================
# Max requests per minute per API key
RATE_LIMIT_PER_KEY=100
# Max messages per minute per phone number
RATE_LIMIT_PER_SENDER=50

# =============================================================================
# WhatsApp Specific Options (whatsapp-web.js)
# =============================================================================
# Session timeout in milliseconds (24 hours)
SESSION_TIMEOUT=86400000

# =============================================================================
# Development Options (Development Mode Only)
# =============================================================================
# Enable debug logging
DEBUG=false
# Print all requests/responses
VERBOSE_LOGGING=false
# Mock WhatsApp responses (for testing)
MOCK_WHATSAPP=false
