# Environment Mode (controls Docker branch selection)
# Options: production, development
APP_ENV=development

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=whatsapp_bridge
DB_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Security
API_KEY=your-secure-api-key-here-change-in-production

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_DIR=./logs

# WhatsApp Configuration
WA_SESSION_NAME=lightwaha
WA_HEADLESS=true
WA_BROWSER_EXECUTABLE_PATH=

# Webhook Configuration
ENABLE_WEBHOOKS=false
WEBHOOK_SECRET=your-webhook-secret-here

# n8n Integration (optional)
N8N_WEBHOOK_URL=http://n8n.thecoordinates.app/webhook/lightwaha
N8N_API_URL=http://n8n.internal:5678
N8N_API_KEY=

# Centralized Execution Logging (makebdd)
EXEC_LOG_ENABLED=false
EXEC_LOG_HOST=mysql.thecoordinates.xyz
EXEC_LOG_PORT=3306
EXEC_LOG_USER=makeuser
EXEC_LOG_PASSWORD=
EXEC_LOG_DATABASE=makebdd

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# Retry Configuration
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Other
TZ=UTC
