    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "n8n-workflow": "^2.10.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
